# GEMINI_API_KEY: Required for Gemini AI API calls and optional neutral Lab recap.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Diagnostic Lab API keys (all stored server-side only):
# X_BEARER_TOKEN: X API v2 Bearer Token for live recent search & account metrics.
X_BEARER_TOKEN=

# GNEWS_API_KEY or NEWS_API_KEY: Optional news APIs (falls back to free Google News RSS if unset).
GNEWS_API_KEY=
NEWS_API_KEY=

# BIRDEYE_API_KEY / HELIUS_API_KEY: Optional Solana holder & RPC enrichment.
BIRDEYE_API_KEY=
HELIUS_API_KEY=

# COINGECKO_API_KEY: Optional CoinGecko Demo API key for higher rate limits.
COINGECKO_API_KEY=
